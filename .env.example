# Root env for docker-compose / Dokploy. Copy to `.env` and fill in.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=pullups

# --- Web app ---
# Password you type to log into the web UI.
APP_PASSWORD=change-me-login-password
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-64-char-random-hex

# --- MQTT (server side) ---
# The web server's MQTT credentials (must exist in mosquitto/passwd).
MQTT_SERVER_USER=server
MQTT_SERVER_PASS=change-me-server-mqtt-password

# --- Device ---
# Must match the ESP32 firmware config.h.
DEVICE_ID=bar-01
DEVICE_KEY=change-me-device-shared-secret

# Timezone for "local day" rollups, streaks, goals (e.g. America/New_York).
APP_TIMEZONE=UTC
