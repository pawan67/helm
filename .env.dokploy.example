# HELM — Dokploy environment
# Paste these into Dokploy → your HELM Compose app → Environment tab.
# (Values are read by docker-compose.dokploy.yml.)

# --- Database: SEPARATE Dokploy Postgres app ---
# Create a "Postgres" app in Dokploy FIRST, then copy its INTERNAL connection
# string here. Its data lives with that app, so redeploying HELM never touches
# your database. The host is the Postgres app's service name on dokploy-network.
DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@<postgres-internal-host>:5432/<db-name>

# --- Web UI login (single user) ---
APP_PASSWORD=change-me-login-password
# Signs the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-64-char-random-hex

# --- MQTT broker (Mosquitto) ---
# The broker's password file is generated from these at container start.
# server = the web app's broker login
MQTT_SERVER_USER=server
MQTT_SERVER_PASS=change-me-server-mqtt-password
# device = the ESP32's broker login. Put the SAME user/pass in firmware/helm/config.h
MQTT_DEVICE_USER=device
MQTT_DEVICE_PASS=change-me-device-mqtt-password

# --- Device ---
# Must match the ESP32 firmware config.h.
DEVICE_ID=bar-01
DEVICE_KEY=change-me-device-shared-secret

# --- Timezone for "local day" rollups, streaks, goals (e.g. America/New_York) ---
APP_TIMEZONE=UTC
