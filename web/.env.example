# --- Web app ---
# Password to log into the web UI (single user).
APP_PASSWORD=change-me-please
# Secret used to sign the session cookie (32+ random chars).
SESSION_SECRET=please-generate-a-long-random-secret-string

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@db:5432/pullups

# --- MQTT broker (Mosquitto) ---
MQTT_URL=mqtt://mqtt:1883
MQTT_USER=server
MQTT_PASS=change-me-server-pass

# --- Device ---
# Must match the ESP32 firmware config.
DEVICE_ID=bar-01
# Shared secret the device includes in payloads (defense in depth).
DEVICE_KEY=change-me-device-key

# Timezone used for "local day" rollups, streaks and goals.
APP_TIMEZONE=UTC
