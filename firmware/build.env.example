# Copy to `build.env` (gitignored) and fill in. Sourced by ./flash.sh.

# Console base URL for OTA pushes.
#   local dev:  http://localhost:3000
#   deployed:   https://helm.pawan67.dev
HELM_URL=http://localhost:3000

# The console login password (APP_PASSWORD in the web env). Needed for `ota`.
HELM_PASSWORD=

# Serial port for `usb` flashing.
PORT=/dev/ttyUSB0

# Board + partition. Keep the min_spiffs partition — the firmware needs it for
# OTA to fit. Change the board id if yours isn't the generic ESP32 Dev Module.
FQBN=esp32:esp32:esp32:PartitionScheme=min_spiffs
